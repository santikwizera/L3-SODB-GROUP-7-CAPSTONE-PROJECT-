```js
function showEmergency() {
    const emergency = HOSPITALS.filter(h => h.open === "24h" || h.type === "emergency");
    // Show only emergency facilities
    currentFilter = 'emergency';
    renderList();
    placeMarkers();
    showToast("Showing 24/7 Emergency Facilities", "success");
}
```

